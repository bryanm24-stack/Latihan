# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH masuk ke git.
PORT=3001
NODE_ENV=development

# MySQL — sesuaikan dengan instalasi lokal kalian.
# DB_NAME akan DIBUAT OTOMATIS oleh `npm run db:migrate` kalau belum ada.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=soa_minggu3

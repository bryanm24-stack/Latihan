          "name": "Cek sudah terhapus -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/buku/{{bukuId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "buku",
                "{{bukuId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Method routing & 405",
      "item": [
        {
          "name": "DELETE koleksi -> 405",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/buku",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "buku"
              ]
            },
            "description": "Alamat /buku ADA, tapi DELETE tidak diizinkan. 405, bukan 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405 Method Not Allowed', () => pm.response.to.have.status(405));",
                  "pm.test('menyertakan header Allow (RFC 9110)', () => {",
                  "  pm.expect(pm.response.headers.has('Allow')).to.be.true;",
                  "  pm.expect(pm.response.headers.get('Allow')).to.include('GET');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST ke satu buku -> 405",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/buku/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "buku",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405', () => pm.response.to.have.status(405));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alamat tidak ada -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tidak-ada",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tidak-ada"
              ]
            },
            "description": "Bandingkan dengan 405 di atas: di sini ALAMATNYA yang tidak ada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 bukan 405', () => pm.response.to.have.status(404));",
                  "pm.test('respons JSON, bukan HTML', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('json');",
                  "});"
                ]
              }
            }
          ]
        }
      ]

{
  "info": {
    "name": "BookData W8 — Subscription Lengkap",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Jalankan semua folder berurutan. Premium Rp99.000/30 hari. Pembayaran simulasi admin, tanpa debit uang. Expiry diuji otomatis di npm test menggunakan fixture database, tanpa endpoint backdoor."
  },
  "item": [
    {
      "name": "1 Pelanggan Basic dan checkout",
      "item": [
        {
          "name": "01 Lihat paket dan harga",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/plans",
            "description": "BookData subscription. Pembayaran adalah simulasi admin, tanpa debit uang sungguhan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Premium 99000 untuk 30 hari\",()=>{const p=pm.response.json().data.find(p=>p.id===\"premium\");pm.expect(p.price).to.eql(99000);pm.expect(p.duration_days).to.eql(30);});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Register pelanggan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "BookData subscription. Pembayaran adalah simulasi admin, tanpa debit uang sungguhan.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pengguna_nama\": \"{{demo_user}}\",\n  \"pengguna_password\": \"Tester123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"demo_user\", \"buyer\"+Date.now()+Math.floor(Math.random()*1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"user_id\", pm.response.json().id);",
                  "pm.test(\"Basic tanpa rahasia\",()=>{const j=pm.response.json();pm.expect(j.api_level).to.eql(\"basic\");pm.expect(j).not.to.have.property(\"api_key\");pm.expect(j).not.to.have.property(\"pengguna_password\");});"
                ]
              }
            }
          ]

        }
      ]
    },
    {
      "name": "06 Basic mendapat ringkasan",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": "{{base_url}}/api/v1/partner/ringkasan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Sisa harian 99\",()=>pm.expect(pm.response.headers.get(\"X-Daily-Remaining\")).to.eql(\"99\"));"
            ]
          }
        }
      ]
    },

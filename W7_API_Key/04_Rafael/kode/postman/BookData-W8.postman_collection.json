        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Partner tanpa key ditolak",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/partner/ringkasan"
      },

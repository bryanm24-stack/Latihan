# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH masuk ke git.
PORT=3001
NODE_ENV=development

# MySQL — sesuaikan dengan instalasi lokal kalian.
# DB_NAME akan DIBUAT OTOMATIS oleh `npm run db:migrate` kalau belum ada.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=soa_bookdata_w8

# API pihak ketiga — Minggu 6
# Webhook Discord (opsional): buat channel Discord -> Integrations -> Webhook.
# Kalau kosong, notifikasi dilewati diam-diam (tidak error).
DISCORD_WEBHOOK_URL=

# JWT — Minggu 7. GENERATE dengan:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Dua-duanya HARUS berbeda. Jangan pernah masuk git.
ACCESS_TOKEN_SECRET=ganti_dengan_64_karakter_acak
REFRESH_TOKEN_SECRET=ganti_dengan_64_karakter_acak_yang_berbeda

# W8: logging SQL opsional dan nama database test terpisah
SQL_LOG=false
TEST_DB_NAME=soa_bookdata_w8_test

# JWT akses default 15 menit. Set 30s jika ingin demonstrasi token singkat.
ACCESS_TOKEN_TTL=15m
